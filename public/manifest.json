{
  "manifest_version": 3,
  "name": "React Tailwind Chrome Extension",
  "version": "1.0.0",
  "description": "A Chrome Extension template built with React, Tailwind, and TypeScript.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "static/js/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Open My Extension"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["static/js/content.js"],
      "css": ["static/css/main.css"]
    }
  ],

   "options_page": "options.html",

  "web_accessible_resources": [
    {
      "resources": ["static/css/*", "static/js/*.js", "logo192.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  }
}
